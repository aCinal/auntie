enclave {
    include "sgx_report.h"

    trusted {
        /**
         * @brief Hand the quote back to the enclave
         * @param quote Remotely verifiable quote
         * @param size Size of the quote
         * @return 0 on success, negative error code on failure
         */
        int ecall_quote_me_callback([in, size=size] const uint8_t *quote, uint32_t size);
    };

    untrusted {
        /**
         * @brief Print a message from within the enclave
         * @param str Message to be printed
         */
        void ocall_print([in, string] const char *str);

        /**
         * @brief Read data from a connection described by @ref context
         * @param context Untrusted context that describes the connection
         * @param buffer Buffer into which the read data is to be written
         * @param size Size of the buffer
         * @return Number of bytes written to the buffer on success, negative error code on failure
         */
        int ocall_ingress(
            [user_check] void *context,
            [out, size=size] uint8_t *buffer,
            size_t size
        );

        /**
         * @brief Write data to a connection described by @ref context
         * @param context Untrusted context that describes the connection
         * @param buffer Buffer from which the data is to be read
         * @param size Size of the buffer
         * @return Number of bytes written sent on success, negative error code on failure
         */
        int ocall_egress(
            [user_check] void *context,
            [in, size=size] const uint8_t *buffer,
            size_t size
        );

        /**
         * @brief Drop a connection described by @ref context
         * @param context Untrusted context that describes the connection
         * @return 0 on success, negative error code on failure
         */
        int ocall_drop_connection([user_check] void *context);

        /**
         * @brief Get information on the local quoting enclave
         * @param qe Target info for the local quoting enclave
         * @return 0 on success, negative error code on failure
         */
        int ocall_get_quoting_enclave([out] sgx_target_info_t *qe);

        /**
         * @brief Transform a local report into a remotely verifiable quote
         * @param report Report generated by the enclave
         * @return 0 on success, negative error code on failure
         * @note This OCALL is explicitly allowed to make a recursive ECALL via @ref ecall_quote_me_callback
         */
        int ocall_quote_me(
            [in] const sgx_report_t *report
        ) allow(ecall_quote_me_callback);

        /**
         * @brief Present the quote of a counterparty's TEEs for the host to verify
         * @param quote Quote of a counterparty's TEE
         * @param quote_length Length of the quote
         * @param report_data Report data supposedly quoted
         * @return 0 on success, negative error code on failure
         */
        int ocall_print_quote([in, size=quote_length] const uint8_t *quote, size_t quote_length, sgx_report_data_t report_data);
    };
};
